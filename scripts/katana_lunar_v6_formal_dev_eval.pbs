#!/bin/bash
#PBS -N lunar_v6_fdev
#PBS -J 0-299
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
source scripts/katana_env.sh

conditions=(DESC BAL ECON)
seeds=(1001 1002 1003 1004 1005 1006 1007 1008 1009 1010 1011 1012 1013 1014 1015 1016 1017 1018 1019 1020)
steps=(600000 700000 800000 900000 1000000)
condition_index=$((PBS_ARRAY_INDEX / 100))
within_condition=$((PBS_ARRAY_INDEX % 100))
seed_index=$((within_condition / 5))
step_index=$((within_condition % 5))
condition="${conditions[$condition_index]}"
seed="${seeds[$seed_index]}"
step="${steps[$step_index]}"
root="outputs/lunar_lander_braking_formal_v2_high_latest"
output="$root/development_eval/step_${step}/$condition/seed_${seed}"

if [[ -e "$output" ]]; then
  echo "Refusing to overwrite formal development output: $output" >&2
  exit 1
fi

python -m experiments.lunar_lander_braking.run evaluate \
  --config experiments/lunar_lander_braking/configs/formal_v6_high_latest.yaml \
  --manifest experiments/lunar_lander_braking/grids/development_high.json \
  --freeze-manifest "$root/frozen/manifest.sha256.json" \
  --condition "$condition" --seed "$seed" \
  --checkpoint "$root/train/$condition/seed_${seed}/checkpoints/step_${step}/model.zip" \
  --output "$output"
