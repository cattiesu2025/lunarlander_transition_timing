#!/bin/bash
#PBS -N lunar_econ_1m_train
#PBS -J 0-2
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
source scripts/katana_env.sh

seeds=(101 202 303)
seed="${seeds[$PBS_ARRAY_INDEX]}"
root="outputs/lunar_lander_braking_pilot_v4_econ_1m"

python -m experiments.lunar_lander_braking.run train \
  --config experiments/lunar_lander_braking/configs/pilot_1m.yaml \
  --condition ECON --seed "$seed" --device cpu \
  --output "$root/train/ECON/seed_${seed}"
