#!/bin/bash
#PBS -N lunar_v6_fheld
#PBS -J 0-59
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
source scripts/katana_env.sh

conditions=(DESC BAL ECON)
seeds=(1001 1002 1003 1004 1005 1006 1007 1008 1009 1010 1011 1012 1013 1014 1015 1016 1017 1018 1019 1020)
condition_index=$((PBS_ARRAY_INDEX / 20))
seed_index=$((PBS_ARRAY_INDEX % 20))
condition="${conditions[$condition_index]}"
seed="${seeds[$seed_index]}"
root="outputs/lunar_lander_braking_formal_v2_high_latest"
output="$root/held_out_eval/$condition/seed_${seed}"

if [[ -e "$output" ]]; then
  echo "Refusing to overwrite sealed held-out output: $output" >&2
  exit 1
fi

checkpoint=$(python scripts/resolve_lunar_checkpoint.py \
  --config experiments/lunar_lander_braking/configs/formal_v6_high_latest.yaml \
  --selection "$root/selection/selected_checkpoints.json" \
  --selection-lock "$root/selection/selected_checkpoints.sha256.json" \
  --freeze-manifest "$root/frozen/manifest.sha256.json" \
  --condition "$condition" --seed "$seed")

python -m experiments.lunar_lander_braking.run evaluate \
  --config experiments/lunar_lander_braking/configs/formal_v6_high_latest.yaml \
  --manifest experiments/lunar_lander_braking/grids/held_out_high.json \
  --freeze-manifest "$root/frozen/manifest.sha256.json" \
  --condition "$condition" --seed "$seed" \
  --checkpoint "$checkpoint" \
  --output "$output"
